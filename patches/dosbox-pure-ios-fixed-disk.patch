+extern "C" void dbp_win95_flush_disk(void)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN) return;
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	for (unsigned i = 0; i != MAX_HDD_IMAGES; ++i)
+		if (imageDiskList[i])
+			imageDiskList[i]->FlushDifferencingDisk();
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+}
+
+extern "C" bool dbp_win95_guest_shutdown(void)
+{
+	return dbp_win95_poweroff_requested.load();
+}
+
+extern "C" bool dbp_win95_mount_cd(const char* path)
+{
+	if (!path || !*path || dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN || dbp_state == DBPSTATE_EXITED)
+		return false;
+
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	bool mounted = false;
+	DOS_Drive* current = Drives['D'-'A'];
+	if (!current || dynamic_cast<isoDrive*>(current))
+	{
+		const unsigned image_index = DBP_AppendImage(path, false);
+		DBP_Mount(image_index, true, 'D');
+		mounted = dbp_images[image_index].mounted && dbp_images[image_index].drive == 'D' &&
+			dynamic_cast<isoDrive*>(Drives['D'-'A']);
+		if (mounted) dbp_image_index = image_index;
+		else if (Drives['D'-'A']) DBP_Unmount('D');
+	}
+	if (mounted) DBP_SetMountSwappingRequested();
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+	if (mounted) DBP_QueueEvent(DBPET_CHANGEMOUNTS, DBP_NO_PORT);
+	return mounted;
+}
+
+extern "C" bool dbp_win95_eject_cd(void)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN || dbp_state == DBPSTATE_EXITED)
+		return false;
+
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	DOS_Drive* current = Drives['D'-'A'];
+	const bool can_eject = !current || dynamic_cast<isoDrive*>(current);
+	const bool changed = current && can_eject;
+	if (changed) DBP_Unmount('D');
+	if (changed) DBP_SetMountSwappingRequested();
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+	if (changed) DBP_QueueEvent(DBPET_CHANGEMOUNTS, DBP_NO_PORT);
+	return can_eject;
+}
