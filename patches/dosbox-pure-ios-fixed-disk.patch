+extern "C" void dbp_win95_flush_disk(void)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN) return;
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	for (unsigned i = 0; i != MAX_HDD_IMAGES; ++i)
+		if (imageDiskList[i])
+			imageDiskList[i]->FlushDifferencingDisk();
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+}
