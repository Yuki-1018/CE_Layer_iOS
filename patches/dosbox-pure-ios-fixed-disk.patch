+extern "C" int dbp_win95_change_cd(const char* path)
+{
+	if (dbp_state == DBPSTATE_BOOT) return 2;
+	if (dbp_state == DBPSTATE_SHUTDOWN || dbp_state == DBPSTATE_EXITED) return 0;
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	const int result = IDE_Win95ChangeCD(path);
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+	return result;
+}
+
+extern "C" bool dbp_win95_disk_ready(void)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN || dbp_state == DBPSTATE_EXITED) return false;
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	const bool ready = imageDiskList['C'-'A'] && IDE_Win95Ready();
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+	return ready;
+}
+
+extern "C" void dbp_win95_flush_disk(void)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN) return;
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	for (unsigned i = 0; i != MAX_HDD_IMAGES; ++i)
+		if (imageDiskList[i])
+			imageDiskList[i]->FlushDifferencingDisk();
+	DBP_ThreadControl(TCM_RESUME_FRAME);
+}
+
+extern "C" bool dbp_win95_guest_shutdown(void)
+{
+	return dbp_win95_poweroff_requested.load();
+}
+
+extern "C" void dbp_win95_send_key(unsigned keycode, bool pressed)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN || dbp_state == DBPSTATE_EXITED || keycode >= RETROK_LAST) return;
+	const int dosbox_key = dbp_keymap_retro2dos[keycode];
+	if (dosbox_key > KBD_NONE && dosbox_key < KBD_LAST)
+		KEYBOARD_AddKey((KBD_KEYS)dosbox_key, pressed);
+}
+
+extern "C" void dbp_win95_release_input(void)
+{
+	if (dbp_state == DBPSTATE_BOOT || dbp_state == DBPSTATE_SHUTDOWN || dbp_state == DBPSTATE_EXITED) return;
+	DBP_ThreadControl(TCM_PAUSE_FRAME);
+	DBP_ReleaseKeyEvents(false);
