+
+// Called with the emulation thread parked. Do not construct an isoDrive here:
+// MSCDEX and DOS media-table writes are not safe in a booted protected-mode OS.
+bool IDE_Win95Ready() { return idecontroller[0] != NULL; }
+
+int IDE_Win95ChangeCD(const char* path)
+{
+	if (!idecontroller[0]) return 2; // frontend retries after the boot frame
+
+	CDROM_Interface_Image* replacement = NULL;
+	const Bit8u slot = 25; // outside the DOS CD units used by this fixed machine
+	if (path && *path)
+	{
+		replacement = new CDROM_Interface_Image(slot);
+		std::vector<char> filename(path, path + strlen(path) + 1);
+		if (!replacement->SetDevice(filename.data(), 0))
+		{
+			delete replacement;
+			CDROM_Interface_Image::images[slot] = win95_cdrom;
+			return 0;
+		}
+	}
+
+	CDROM_Interface_Image* old = win95_cdrom;
+	win95_cdrom_controlled = true;
+	win95_cdrom = NULL;
+	IDE_RefreshCDROMs(); // detach first, including on disc-to-disc replacement
+	delete old;
+	win95_cdrom = replacement;
+	CDROM_Interface_Image::images[slot] = replacement;
+	IDE_RefreshCDROMs();
+	win95_cdrom_path = (path ? path : "");
+	return 1;
 }
 
 void IDE_ShutdownControllers(void)
 {
 	for (IDEController*& c : idecontroller)
 		if (c) { delete c; c = NULL; }
+	delete win95_cdrom;
+	win95_cdrom = NULL;
+	if (win95_cdrom_controlled) CDROM_Interface_Image::images[25] = NULL;
+	win95_cdrom_controlled = false;
 }
 
